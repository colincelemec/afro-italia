services:
  # PostgreSQL Database
  postgres:
    image: postgis/postgis:15-3.3
    container_name: afroitalia_db
    restart: always
    environment:
      POSTGRES_USER: afroitalia
      POSTGRES_PASSWORD: afroitalia123
      POSTGRES_DB: afroitalia_db
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - afroitalia_network

  # Redis (pour cache et rate limiting)
  redis:
    image: redis:7-alpine
    container_name: afroitalia_redis
    restart: always
    ports:
      - "6379:6379"
    volumes:
      - redis_data:/data
    networks:
      - afroitalia_network

  # pgAdmin (optionnel - pour gérer la base de données via interface web)
  pgadmin:
    image: dpage/pgadmin4:latest
    container_name: afroitalia_pgadmin
    restart: always
    environment:
      PGADMIN_DEFAULT_EMAIL: admin@afroitalia.com
      PGADMIN_DEFAULT_PASSWORD: admin123
    ports:
      - "5050:80"
    volumes:
      - pgadmin_data:/var/lib/pgadmin
    networks:
      - afroitalia_network
    depends_on:
      - postgres

volumes:
  postgres_data:
  redis_data:
  pgadmin_data:

networks:
  afroitalia_network:
    driver: bridge
